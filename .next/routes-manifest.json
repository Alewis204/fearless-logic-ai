{
  "version": 3,
  "pages404": true,
  "appType": "app",
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "priority": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [],
  "onMatchHeaders": [],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [],
    "fallback": []
  },
  "dynamicRoutes": [
    {
      "page": "/api/auth/[...nextauth]",
      "regex": "^/api/auth/(.+?)(?:/)?$",
      "routeKeys": {
        "nxtPnextauth": "nxtPnextauth"
      },
      "namedRegex": "^/api/auth/(?<nxtPnextauth>.+?)(?:/)?$"
    },
    {
      "page": "/api/preview/[subdomain]",
      "regex": "^/api/preview/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPsubdomain": "nxtPsubdomain"
      },
      "namedRegex": "^/api/preview/(?<nxtPsubdomain>[^/]+?)(?:/)?$"
    },
    {
      "page": "/api/projects/[id]",
      "regex": "^/api/projects/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/api/projects/(?<nxtPid>[^/]+?)(?:/)?$"
    },
    {
      "page": "/api/projects/[id]/duplicate",
      "regex": "^/api/projects/([^/]+?)/duplicate(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/api/projects/(?<nxtPid>[^/]+?)/duplicate(?:/)?$"
    },
    {
      "page": "/api/projects/[id]/generate-blueprint",
      "regex": "^/api/projects/([^/]+?)/generate\\-blueprint(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/api/projects/(?<nxtPid>[^/]+?)/generate\\-blueprint(?:/)?$"
    },
    {
      "page": "/api/projects/[id]/publish",
      "regex": "^/api/projects/([^/]+?)/publish(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/api/projects/(?<nxtPid>[^/]+?)/publish(?:/)?$"
    },
    {
      "page": "/projects/[id]/blueprint",
      "regex": "^/projects/([^/]+?)/blueprint(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/projects/(?<nxtPid>[^/]+?)/blueprint(?:/)?$"
    },
    {
      "page": "/projects/[id]/edit",
      "regex": "^/projects/([^/]+?)/edit(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/projects/(?<nxtPid>[^/]+?)/edit(?:/)?$"
    },
    {
      "page": "/projects/[id]/preview",
      "regex": "^/projects/([^/]+?)/preview(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/projects/(?<nxtPid>[^/]+?)/preview(?:/)?$"
    },
    {
      "page": "/projects/[id]/publish/success",
      "regex": "^/projects/([^/]+?)/publish/success(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/projects/(?<nxtPid>[^/]+?)/publish/success(?:/)?$"
    }
  ],
  "staticRoutes": [
    {
      "page": "/",
      "regex": "^/(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/(?:/)?$"
    },
    {
      "page": "/_global-error",
      "regex": "^/_global\\-error(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_global\\-error(?:/)?$"
    },
    {
      "page": "/_not-found",
      "regex": "^/_not\\-found(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_not\\-found(?:/)?$"
    },
    {
      "page": "/api/billing/create-checkout-session",
      "regex": "^/api/billing/create\\-checkout\\-session(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/billing/create\\-checkout\\-session(?:/)?$"
    },
    {
      "page": "/api/billing/create-portal-session",
      "regex": "^/api/billing/create\\-portal\\-session(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/billing/create\\-portal\\-session(?:/)?$"
    },
    {
      "page": "/api/billing/webhook",
      "regex": "^/api/billing/webhook(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/billing/webhook(?:/)?$"
    },
    {
      "page": "/api/projects",
      "regex": "^/api/projects(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/projects(?:/)?$"
    },
    {
      "page": "/api/publish/check-subdomain",
      "regex": "^/api/publish/check\\-subdomain(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/publish/check\\-subdomain(?:/)?$"
    },
    {
      "page": "/api/user/profile",
      "regex": "^/api/user/profile(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/user/profile(?:/)?$"
    },
    {
      "page": "/dashboard",
      "regex": "^/dashboard(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/dashboard(?:/)?$"
    },
    {
      "page": "/favicon.ico",
      "regex": "^/favicon\\.ico(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/favicon\\.ico(?:/)?$"
    },
    {
      "page": "/login",
      "regex": "^/login(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/login(?:/)?$"
    },
    {
      "page": "/pricing",
      "regex": "^/pricing(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/pricing(?:/)?$"
    },
    {
      "page": "/projects/new",
      "regex": "^/projects/new(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/projects/new(?:/)?$"
    },
    {
      "page": "/signup",
      "regex": "^/signup(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/signup(?:/)?$"
    }
  ],
  "dataRoutes": [],
  "rsc": {
    "header": "rsc",
    "varyHeader": "rsc, next-router-state-tree, next-router-prefetch, next-router-segment-prefetch",
    "prefetchHeader": "next-router-prefetch",
    "didPostponeHeader": "x-nextjs-postponed",
    "contentTypeHeader": "text/x-component",
    "suffix": ".rsc",
    "prefetchSegmentHeader": "next-router-segment-prefetch",
    "prefetchSegmentSuffix": ".segment.rsc",
    "prefetchSegmentDirSuffix": ".segments",
    "clientParamParsing": false,
    "dynamicRSCPrerender": false
  },
  "rewriteHeaders": {
    "pathHeader": "x-nextjs-rewritten-path",
    "queryHeader": "x-nextjs-rewritten-query"
  }
}